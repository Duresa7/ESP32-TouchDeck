# Defaults for the Waveshare ESP32-S3-Touch-LCD-5B.
# Applied when sdkconfig is first generated; run `idf.py menuconfig` to change
# settings, or delete sdkconfig to regenerate it from this file.

CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The debug console reads input from USB-Serial/JTAG, so it must be the primary
# console. UART0 is wired to the RS485 transceiver on this board, not to USB.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 8 MB octal PSRAM, needed for the 1024x600 RGB display frame buffers.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n

# RGB panel settings from Espressif's LCD FAQ and Waveshare's demo. The bounce
# buffer copy runs in an interrupt, so it needs a 64-byte data cache line and
# must not read flash. XIP from PSRAM keeps code and read-only data off the
# flash bus, so a flash write cannot desync the panel.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL 9 through esp_lvgl_adapter. The snapshot module backs the screenshot
# console command.
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_48=y
