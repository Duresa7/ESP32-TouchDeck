{
  "appId": "io.github.duresa7.touchdeck",
  "productName": "Open TouchDeck",
  "copyright": "Copyright Duresa Kadi",
  "directories": { "buildResources": "installer" },
  "files": ["dist/**/*.js", "package.json"],
  "asar": true,
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "publish": null,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "../src-tauri/icons/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "differentialPackage": false,
    "runAfterFinish": true,
    "shortcutName": "Open TouchDeck",
    "uninstallDisplayName": "Open TouchDeck",
    "include": "installer/installer.nsh",
    "artifactName": "OpenTouchDeck-windows-x64-setup.${ext}"
  }
}
