{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Duresa7/ESP32-TouchDeck/schema/layout.schema.json",
  "title": "TouchDeck layout versions 1 and 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "orientation",
    "pages"
  ],
  "properties": {
    "schema": {
      "enum": [
        1,
        2
      ],
      "x-rules": {
        "enum": "layout.schema-version"
      }
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "orientation": {
      "enum": [
        "landscape",
        "portrait"
      ],
      "x-rules": {
        "enum": "layout.orientation"
      }
    },
    "fullScreen": {
      "type": "boolean"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/page"
      },
      "x-rules": {
        "minItems": "layout.page-count",
        "maxItems": "layout.page-count"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,15}$",
      "x-rules": {
        "pattern": "id.format"
      }
    },
    "string": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
      "x-rules": {
        "pattern": "string.control-character"
      }
    },
    "text": {
      "type": "string",
      "$ref": "#/$defs/string",
      "minLength": 1,
      "x-rules": {
        "minLength": "text.empty"
      }
    },
    "name": {
      "type": "string",
      "$ref": "#/$defs/string",
      "maxLength": 24,
      "pattern": "[^\\p{White_Space}]",
      "x-rules": {
        "maxLength": "name.too-long",
        "pattern": "name.blank"
      }
    },
    "title": {
      "type": "string",
      "$ref": "#/$defs/string",
      "maxLength": 24,
      "pattern": "[^\\p{White_Space}]",
      "x-rules": {
        "maxLength": "title.too-long",
        "pattern": "title.blank"
      }
    },
    "label": {
      "type": "string",
      "$ref": "#/$defs/string",
      "maxLength": 16,
      "pattern": "[^\\p{White_Space}]",
      "x-rules": {
        "maxLength": "label.too-long",
        "pattern": "label.blank"
      }
    },
    "gridSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "x-rules": {
        "minimum": "grid.size",
        "maximum": "grid.size"
      }
    },
    "span": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "x-rules": {
        "minimum": "tile.span",
        "maximum": "tile.span"
      }
    },
    "position": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "x-rules": {
        "minimum": "tile.position",
        "maximum": "tile.position"
      }
    },
    "modifier": {
      "enum": [
        "ctrl",
        "shift",
        "alt",
        "win"
      ],
      "x-rules": {
        "enum": "modifier.unknown"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/string"
      }
    },
    "page": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "kind",
            "rows",
            "cols",
            "tiles"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "$ref": "#/$defs/title"
            },
            "kind": {
              "const": "grid"
            },
            "rows": {
              "$ref": "#/$defs/gridSize"
            },
            "cols": {
              "$ref": "#/$defs/gridSize"
            },
            "tiles": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/tile"
              },
              "x-rules": {
                "maxItems": "page.tile-count"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "kind",
            "source"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "$ref": "#/$defs/title"
            },
            "kind": {
              "const": "dashboard"
            },
            "source": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ],
      "x-rules": {
        "oneOf": "page.kind"
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "row",
        "col",
        "rowSpan",
        "colSpan",
        "icon",
        "action"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "row": {
          "$ref": "#/$defs/position"
        },
        "col": {
          "$ref": "#/$defs/position"
        },
        "rowSpan": {
          "$ref": "#/$defs/span"
        },
        "colSpan": {
          "$ref": "#/$defs/span"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:lv:(?:prev|play_pause|next|mute|volume_mid|volume_max)|file:[0-9a-f]{16})$",
          "x-rules": {
            "pattern": "icon.format"
          }
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "asset": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$",
          "x-rules": {
            "pattern": "icon.format"
          }
        },
        "render": {
          "enum": [
            "gif",
            "graph",
            "bar",
            "now-playing"
          ],
          "x-rules": {
            "enum": "icon.format"
          }
        },
        "streams": {
          "type": "object"
        },
        "input": {
          "const": true,
          "x-rules": {
            "const": "tile.input"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "asset"
            ],
            "properties": {
              "asset": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "icon": {
                "type": "null",
                "x-rules": {
                  "type": "icon.format"
                }
              }
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "usage",
            "mods"
          ],
          "properties": {
            "type": {
              "const": "key"
            },
            "usage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255,
              "x-rules": {
                "minimum": "key.usage-range",
                "maximum": "key.usage-range"
              }
            },
            "mods": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/modifier"
              },
              "x-rules": {
                "uniqueItems": "key.mods-duplicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "mod"
          ],
          "properties": {
            "type": {
              "const": "mod"
            },
            "mod": {
              "$ref": "#/$defs/modifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "usage"
          ],
          "properties": {
            "type": {
              "const": "consumer"
            },
            "usage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "x-rules": {
                "minimum": "consumer.usage-range",
                "maximum": "consumer.usage-range"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "page"
          ],
          "properties": {
            "type": {
              "const": "page"
            },
            "page": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path",
            "args",
            "cwd"
          ],
          "properties": {
            "type": {
              "const": "launch"
            },
            "path": {
              "$ref": "#/$defs/text"
            },
            "args": {
              "$ref": "#/$defs/args"
            },
            "cwd": {
              "$ref": "#/$defs/string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "open"
            },
            "target": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "program",
            "args",
            "cwd",
            "shell"
          ],
          "properties": {
            "type": {
              "const": "command"
            },
            "program": {
              "$ref": "#/$defs/text"
            },
            "args": {
              "$ref": "#/$defs/args"
            },
            "cwd": {
              "$ref": "#/$defs/string"
            },
            "shell": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "source",
            "field",
            "account"
          ],
          "properties": {
            "type": {
              "const": "widget"
            },
            "source": {
              "$ref": "#/$defs/text"
            },
            "field": {
              "$ref": "#/$defs/text"
            },
            "account": {
              "$ref": "#/$defs/string"
            }
          }
        }
      ],
      "x-rules": {
        "oneOf": "action.type"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "pages": {
            "items": {
              "properties": {
                "tiles": {
                  "items": {
                    "properties": {
                      "asset": false,
                      "render": false,
                      "streams": false,
                      "input": false
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tiles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "allOf": [
                      {
                        "if": {
                          "required": [
                            "render"
                          ],
                          "properties": {
                            "render": {
                              "const": "gif"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "asset"
                          ],
                          "x-rules": {
                            "required": "icon.format"
                          },
                          "properties": {
                            "asset": {
                              "type": "string",
                              "x-rules": {
                                "type": "icon.format"
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "required": [
                            "render"
                          ],
                          "properties": {
                            "render": {
                              "enum": [
                                "bar",
                                "now-playing"
                              ]
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "asset": {
                              "type": "null",
                              "x-rules": {
                                "type": "icon.format"
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "required": [
                            "input"
                          ],
                          "properties": {
                            "input": true
                          }
                        },
                        "then": {
                          "required": [
                            "render"
                          ],
                          "x-rules": {
                            "required": "tile.input"
                          },
                          "properties": {
                            "render": {
                              "const": "bar",
                              "x-rules": {
                                "const": "tile.input"
                              }
                            },
                            "action": {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "const": "widget",
                                  "x-rules": {
                                    "const": "tile.input"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
